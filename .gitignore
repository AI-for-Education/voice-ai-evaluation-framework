# Ignore large model files and common large artifacts
# Framework-local model stores. Profiles live beside these directories and are tracked.
inference/nemo/models/**
!inference/nemo/models/.gitkeep
inference/transformers/models/**
!inference/transformers/models/.gitkeep
inference/sherpa_onnx/models/**
!inference/sherpa_onnx/models/.gitkeep
inference/torch/models/**
!inference/torch/models/.gitkeep
inference/onnxruntime/models/**
!inference/onnxruntime/models/.gitkeep
inference/multimodal/models/**
!inference/multimodal/models/.gitkeep
inference/multimodal/tmp/**
!inference/multimodal/tmp/phi4/.gitkeep
inference/tmp_other/models/**

# Never commit audio recordings or confidential evaluation data
*.[Ww][Aa][Vv]
input_output_data/output/**
input_output_data/input/**


# Generic binary model files
*.nemo
*.ckpt

# Temporary / generated files
/output/
/outputs/
inference/nemo/tmp/**
!inference/nemo/tmp/.gitkeep
inference/transformers/tmp/**
!inference/transformers/tmp/.gitkeep
docker-compose.override.yml
*.egg-info/
__pycache__/
.ipynb_checkpoints/
.venv*/
.pytest_cache/
venv/
env/
tmp/
input_output_data/archive
*.pyc
*.pyo
*.so

# OS files
.DS_Store
Thumbs.db

# Local-development documentation stays in the workspace; only the shared
# vocabulary contract is versioned.
/docs/*
!/docs/vocabulary.md
