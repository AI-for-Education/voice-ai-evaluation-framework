nemo_inference/models/**/*.nemo
nemo_inference/models/**/*.ckpt
nemo_inference/models/*.nemo
nemo_inference/models/*.ckpt

# Generic binary model files
*.nemo
*.ckpt

# Temporary / generated files
nemo_inference/tmp/
*.egg-info/
__pycache__/
.venv*/
.pytest_cache/
venv/
env/
*.pyc
*.pyo
*.so

# OS files
.DS_Store
Thumbs.db
