FROM python:3.11-slim

ENV PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    PYTHONPATH=/app \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    PORT=8501

WORKDIR /work

# Keep dashboard dependencies isolated from every ASR/model image.
RUN python3 -m pip install --upgrade \
      pip==25.1.1 \
      setuptools==80.9.0 \
      wheel==0.45.1 \
 && python3 -m pip install \
      streamlit==1.51.0 \
      pandas==2.3.3 \
      numpy==2.3.4

# Evaluation outputs are intentionally not copied into the image. Compose
# mounts only input_output_data/output read-only at runtime.
COPY egra_leaderboard.py /app/egra_leaderboard.py
COPY egra_eval2/leaderboard.py /app/egra_eval2/leaderboard.py
COPY egra_eval2/leaderboard_context.py /app/egra_eval2/leaderboard_context.py
COPY egra_eval2/leaderboard_view.py /app/egra_eval2/leaderboard_view.py
COPY egra_eval2/model_presentation.py /app/egra_eval2/model_presentation.py
COPY egra_eval2/model_presentation.json /app/egra_eval2/model_presentation.json
COPY egra_eval2/reference/__init__.py /app/egra_eval2/reference/__init__.py
COPY egra_eval2/reference/g2p.py /app/egra_eval2/reference/g2p.py
COPY inference/__init__.py /app/inference/__init__.py
COPY inference/pipeline_provenance.py /app/inference/pipeline_provenance.py
COPY inference/provenance.py /app/inference/provenance.py

EXPOSE 8501

CMD ["streamlit", "run", "/app/egra_leaderboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--", "--evaluations-root", "input_output_data/output/evaluations"]
