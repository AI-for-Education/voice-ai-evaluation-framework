FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    python3 python3-dev python3-pip \
    libsndfile1 \
    build-essential cmake \
    libboost-program-options-dev libboost-system-dev libboost-thread-dev \
    libbz2-dev liblzma-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --upgrade \
    pip==25.1.1 \
    setuptools==80.9.0 \
    wheel==0.45.1

# Fairseq2 links against PyTorch's C++ API, so the wheel index must exactly
# match this Torch/CUDA pair. CUDA 12.8 also supports the local RTX 5080.
RUN pip3 install \
    torch==2.7.1 \
    torchaudio==2.7.1 \
    --index-url https://download.pytorch.org/whl/cu128

RUN pip3 install \
    "fairseq2[arrow]==0.5.2" \
    --extra-index-url https://fair.pkg.atmeta.com/fairseq2/whl/pt2.7.1/cu128

RUN pip3 install \
    omnilingual-asr==0.2.0 \
    soundfile==0.13.1 \
    librosa==0.11.0 \
    PyYAML==6.0.2 \
    tqdm==4.67.1 \
    psutil==5.9.5 \
 && pip3 check

WORKDIR /work
ENTRYPOINT ["python3"]
